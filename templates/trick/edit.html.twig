{% extends 'base.html.twig' %}

{% block title %}Edition : {{ trick.name }}{% endblock %}

{% block body %}
<header class="masthead" style="background-image: url('{{ trick.mainImage ? asset('uploads/images/' ~ trick.mainImage) : asset('img/snowboard-bg.jpg') }}')">
  <div class="container position-relative px-4 px-lg-5">
    <div class="row gx-4 gx-lg-5 justify-content-center">
      <div class="col-md-10 col-lg-8 col-xl-7 text-center">
        <h1 class="text-white">Edition : {{ trick.name }}</h1>
        <div class="mt-3">
          {% if trick.mainImage %}
            <form class="d-inline" action="{{ path('app_trick_image_delete', {id: trick.id}) }}" method="post" onsubmit="return confirm('Delete the main image?')">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_image_' ~ trick.id) }}">
              <input type="hidden" name="filename" value="{{ trick.mainImage }}">
              <button type="submit" class="btn btn-danger btn-sm">Delete main image</button>
            </form>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</header>

<div class="container px-4 px-lg-5 my-3 d-flex justify-content-between align-items-center">
    <a href="{{ path('app_homepage') }}#trick-list" class="btn btn-secondary">← Back to list</a>

    <form action="{{ path('app_trick_delete', {id: trick.id}) }}" method="post" onsubmit="return confirm('Delete this trick?')">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ trick.id) }}">
    <button type="submit" class="btn btn-outline-danger">Delete trick</button>
    </form>
</div>

<div class="container px-4 px-lg-5">
  <h5 class="mb-3">Images</h5>
  <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">
    {% for image in trick.imagePaths ?? [] %}
      <div class="col">
        <div class="card h-100">
          <img class="card-img-top" src="{{ asset('uploads/images/' ~ image) }}" alt="{{ trick.name }}">
          <div class="card-body p-2 d-flex flex-column gap-2">
            <div class="d-grid">
              <form action="{{ path('app_trick_image_set_main', {id: trick.id}) }}" method="post" class="d-grid">
                <input type="hidden" name="filename" value="{{ image }}">
                <button type="submit" class="btn btn-sm {{ image == trick.mainImage ? 'btn-primary' : 'btn-outline-primary' }}">
                  {{ image == trick.mainImage ? 'Main image' : 'Set as main image' }}
                </button>
              </form>
            </div>
            <div class="d-grid">
              <form action="{{ path('app_trick_image_delete', {id: trick.id}) }}" method="post" onsubmit="return confirm('Supprimer cette image ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_image_' ~ trick.id) }}">
                <input type="hidden" name="filename" value="{{ image }}">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    {% else %}
      <div class="text-muted">No image available</div>
    {% endfor %}
  </div>

  <hr class="my-4">

  <h5 class="mb-3">Videos</h5>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3 mb-3">
    {% for embed in trick.videoEmbeds ?? [] %}
      <div class="col">
        <div class="card h-100">
          <div class="ratio ratio-16x9">
            <div class="w-100 h-100">{% if embed %}{{ embed|raw }}{% else %}<div class="d-flex align-items-center justify-content-center text-muted">No video</div>{% endif %}</div>
          </div>
          <div class="card-body p-2 d-flex justify-content-between">
            <form action="{{ path('app_trick_video_delete', {id: trick.id}) }}" method="post" onsubmit="return confirm('Supprimer cette vidéo ?')">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_video_' ~ trick.id) }}">
              <input type="hidden" name="index" value="{{ loop.index0 }}">
              <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
          </div>
        </div>
      </div>
    {% else %}
      <div class="text-muted">No video available</div>
    {% endfor %}
  </div>

  <hr class="my-4">

  <div class="card">
    <div class="card-body">
      {{ form_start(form) }}
        <div class="row g-3">
          <div class="col-12 col-md-6">
            {{ form_row(form.name) }}
          </div>
          <div class="col-12 col-md-6">
            {{ form_row(form.type) }}
          </div>
          <div class="col-12">
            {{ form_row(form.description) }}
          </div>
          <div class="col-12">
            {{ form_row(form.imagePaths, {label: 'Add images'}) }}
          </div>
          <div class="col-12">
            <label class="form-label">Videos (embeds)</label>
            {{ form_widget(form.videoEmbeds) }}
          </div>
        </div>
        <div class="mt-3 d-flex gap-2">
          <button type="submit" class="btn btn-primary">Save</button>
          <a href="{{ path('app_homepage') }}#trick-list" class="btn btn-outline-secondary">Cancel</a>
        </div>
      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Trick{% endblock %}

{% block body %}
    <!-- Page Header -->
    <header class="masthead" style="background-image: url('{{ asset('img/snowboard-bg.jpg') }}')">
        <div class="container position-relative px-4 px-lg-5">
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-md-10 col-lg-8 col-xl-7">
                    <div class="site-heading">
                        <h1>{{ trick.name }}</h1>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Back Button -->
    <div class="container px-4 px-lg-5 my-3">
        <a href="{{ path('app_homepage') }}#trick-list" class="btn btn-secondary text-uppercase">
            ← Back to list
        </a>
    </div>

    <div class="container flex px-4 px-lg-5">

        {% for image in trick.imagePaths %}
            <img src="{{ asset('uploads/images/' ~ image) }}" alt="{{ trick.name }}" style="max-width: 200px;">
        {% endfor %}

                
        <p>{{ trick.description }}</p>
        
        <div>
            <span class="badge bg-primary">{{ trick.type }}</span>
            <span class="badge bg-info">Créé le 04/03/2025 à 12h00</span>
            <span class="badge bg-info">Modifié le 04/03/2025 à 16h00</span>
        </div>
        
        <hr/>
        <div class="form-container">
            <input type="text" class="comment-box" placeholder="Write a comment...">
            <button class="comment-button">Leave a comment</button>
        </div>
        <hr/>
        <div class="comment-section">
        <div class="comment">
            <img src="{{ asset('img/snowboard-bg.jpg') }}" alt="Profil" class="profile-pic">
            <div class="comment-box">
                <div class="comment-author">Kayden</div>
                <div class="comment-text">Dernier commentaire. J'adore réaliser cette figure avec mon snowboard.</div>
            </div>
        </div>
        <div class="comment">
            <img src="{{ asset('img/snowboard-bg.jpg') }}" alt="Profil" class="profile-pic">
            <div class="comment-box">
                <div class="comment-author">Inconnu</div>
                <div class="comment-text">Troisième commentaire</div>
            </div>
        </div>
        <div class="comment">
            <img src="{{ asset('img/snowboard-bg.jpg') }}" alt="Profil" class="profile-pic">
            <div class="comment-box">
                <div class="comment-author">Anonyme</div>
                <div class="comment-text">Deuxième commentaire</div>
            </div>
        </div>
        <div class="comment">
            <img src="{{ asset('img/snowboard-bg.jpg') }}" alt="Profil" class="profile-pic">
            <div class="comment-box">
                <div class="comment-author">Quidam</div>
                <div class="comment-text">Premier commentaire</div>
            </div>
        </div>
        <div class="d-flex justify-content-center mb-4"><a class="btn btn-primary text-uppercase" href="#">Load more</a></div>
    </div>
    </div>
{% endblock %}

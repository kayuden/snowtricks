{% extends 'base.html.twig' %}

{% block title %}Homepage{% endblock %}

{% block body %}
    <!-- Page Header-->
    <header class="masthead full-height" style="background-image: url('{{ asset('img/snowboard-bg.jpg') }}')">
        <div class="container position-relative px-4 px-lg-5">
            <div class="row gx-4 gx-lg-5 justify-content-center">
                <div class="col-md-10 col-lg-8 col-xl-7">
                    <div class="site-heading">
                        <h1>Trick it & Post it !</h1>
                    </div>
                </div>
            </div>
        </div>
        <!-- Arrow Down -->
        <div class="arrow-down">
            <a href="{{ url('app_homepage') }}#tricks-block" class="arrow-down">
                <img src="{{ asset('img/arrow-down.svg') }}" alt="Down arrow">
            </a>
        </div>
    </header>

    <!-- Main Content-->
    <div id="tricks-block" class="container px-4 px-lg-5">
        <div class="row gx-4 gx-lg-5 justify-content-center">
            
            <!-- Flash messages -->
            {% for label, messages in app.flashes %}
                <div class="alert alert-{{ label }}">
                    {% for message in messages %}
                        {{ message }}
                    {% endfor %}
                </div>
            {% endfor %}

            <!-- New trick -->
            {% if app.user %}
                <div class="container px-4 px-lg-5 my-3">
                    <a href="{{ path('app_trick_new') }}#trick-list" class="btn btn-secondary text-uppercase">
                        New trick
                    </a>
                </div>
            {% endif %}
            
            <!-- Trick list -->
            <div id="trick-list" class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-4 mb-4">
                {% for trick in tricks %}
                    <div class="col trick-card">
                        <div class="card h-100">
                            {% set mainImage = trick.imagePaths[0] ?? null %}
                            {% set imagePath = mainImage ? asset('uploads/images/' ~ trick.mainImage) : 'img/snowboard-bg.jpg' %}
                            <img src="{{ asset(imagePath) }}" class="card-img-top" alt="Trick image">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <a href="{{ path('app_trick_show', { id: trick.id }) }}" class="fw-bold">
                                    {{ trick.name }}
                                </a>
                                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                                    <div class="d-flex gap-2">
                                        <a href="{{ path('app_trick_edit', { id: trick.id }) }}">
                                            <img src="{{ asset('img/pencil-solid.svg') }}" alt="Edit" width="18">
                                        </a>
                                        <form method="post" action="{{ path('app_trick_delete', { 'id': trick.id }) }}" onsubmit="return confirm('Supprimer ce trick ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ trick.id) }}">
                                            <button class="btn p-0 border-0 bg-transparent" type="submit">
                                                <img src="{{ asset('img/trash-solid.svg') }}" alt="Delete" width="18">
                                            </button>
                                        </form>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                <div>Aucun trick.</div>
                {% endfor %}
            </div>

            <!-- Load More Button -->
            {% if tricks|length >= 10 %}
            <div class="d-flex justify-content-center mb-4">
                <button id="load-more-btn" class="btn btn-primary" data-offset="10" data-url="{{ path('load_tricks') }}" type="button">
                    Load more
                </button>
            </div>
            {% endif %}
        </div>
    </div>

    <!-- Arrow Up -->
    <div class="position-fixed bottom-0 end-0 m-4" id="scrollToTop" style="display: none;">
        <a href="#">
            <img src="{{ asset('img/arrow-up.svg') }}" alt="Up arrow" width="32" height="32">
        </a>
    </div>

{% endblock %}

{% for trick in tricks %}
    <div class="col trick-card">
        <div class="card h-100">
            <img src="{{ asset('img/snowboard-bg.jpg') }}" class="card-img-top" alt="Trick image">
            <div class="card-body d-flex justify-content-between align-items-center">
                <a href="#" class="fw-bold text-decoration-none text-dark">
                    {{ trick.name }}
                </a>
                <div class="d-flex gap-2">
                    <a href="#">
                        <img src="{{ asset('img/pencil-solid.svg') }}" alt="Edit" width="18">
                    </a>
                    <a href="#" onclick="return confirm('Supprimer ce trick ?');">
                        <img src="{{ asset('img/trash-solid.svg') }}" alt="Delete" width="18">
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endfor %}

{% for trick in tricks %}
    <div class="col trick-card">
        <div class="card h-100">
            {% set firstImage = trick.imagePaths[0] ?? null %}
            {% set imagePath = firstImage ? 'uploads/images/' ~ firstImage : 'img/snowboard-bg.jpg' %}
            <img src="{{ asset(imagePath) }}" class="card-img-top" alt="Trick image">
            <div class="card-body d-flex justify-content-between align-items-center">
                <a href="#" class="fw-bold open-trick-modal" data-id="{{ trick.id }}">
                    {{ trick.name }}
                </a>
                <div class="d-flex gap-2">
                    <a href="#" class="open-trick-edit-modal" data-id="{{ trick.id }}">
                        <img src="{{ asset('img/pencil-solid.svg') }}" alt="Edit" width="18">
                    </a>
                    <form method="post" action="{{ path('app_admin_trick_delete', { 'id': trick.id }) }}" onsubmit="return confirm('Supprimer ce trick ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ trick.id) }}">
                        <button class="btn p-0 border-0 bg-transparent" type="submit">
                            <img src="{{ asset('img/trash-solid.svg') }}" alt="Delete" width="18">
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endfor %}